{
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": ".*/(c|cpp)/\\d{2}/README\\.md",
        "cmd": "${workspaceFolder}/build.sh ${file} $(dirname ${file})/temp.md $(dirname ${file})/temp.pdf && cat ${file} | grep ')\\*\\*' | grep -v ']('"
      }
    ]
  },
  // Munseong: disable autosave to avoid frequent rebuilds
  "files.autoSave": "off",

  "editor.rulers": [80, 120],
  "files.associations": {
    "*.ipp": "cpp",
    "*.tcc": "cpp",
    "CMakeLists.txt": "cmake",
    "*.cmake": "cmake",
    "*.mk": "makefile",
    "Makefile": "makefile",
    "*.jsonc": "jsonc",
    "*.config": "json",
    "Jenkinsfile": "groovy",
    "*.xml": "xml",
    "*.properties": "ini",
    "*.gradle": "groovy",
    "*.jsp": "html",
    "*.tag": "html",
    "*.htm": "html",
    "*.html": "html",
    "*.css": "css",
    "*.js": "javascript",
    "*.ts": "typescript",
    "*.md": "markdown",
    "*.mdx": "markdown",
    "Dockerfile": "dockerfile",
    "*.dockerfile": "dockerfile",
    "*.myp": "python",
    "SConstruct": "python",
    "wscript": "python",
    "*.tac": "python",
    "iomanip": "cpp",
    "random": "cpp",
    "iostream": "cpp"
  }
}
